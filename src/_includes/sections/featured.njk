<div class="section-wrap section-wrap--alt">
  <section id="featured">
    <a href="#featured" class="section-header reveal">
      <span class="section-number">{{ t.featured.number }}</span>
      <h2 class="section-title">{{ t.featured.title }}</h2>
      <div class="section-line"></div>
    </a>

    <div class="featured-grid">
      <a href="https://www.youtube.com/watch?v=CCc3SREchJE&t=539" target="_blank" rel="noopener" class="video-embed reveal">
        <img src="https://img.youtube.com/vi/CCc3SREchJE/maxresdefault.jpg" alt="{{ t.featured.webinar.title }}" loading="lazy">
        <div class="play-btn">
          <svg viewBox="0 0 68 48"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.64 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="var(--accent)"/><path d="M45 24L27 14v20" fill="var(--bg)"/></svg>
        </div>
      </a>
      <div class="featured-text reveal">
        <h3>{{ t.featured.webinar.title }}</h3>
        <p>{{ t.featured.webinar.desc }}</p>
        <div class="featured-badges">
          <a href="https://www.youtube.com/watch?v=CCc3SREchJE&t=539" target="_blank" rel="noopener" class="badge">
            <svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            {{ t.featured.webinar.watchOnYoutube }}
          </a>
        </div>
      </div>
    </div>

    <div class="featured-grid">
      <div class="fhnw-slideshow reveal">
        <div class="fhnw-slides">
          <img src="/assets/img/fhnw-talk-presenters-title.jpg" alt="{{ t.featured.fhnw.altTitleSlide }}" class="fhnw-slide active" loading="lazy">
          <img src="/assets/img/fhnw-talk-audience-overview.jpg" alt="{{ t.featured.fhnw.altAudienceOverview }}" class="fhnw-slide" loading="lazy">
          <img src="/assets/img/fhnw-talk-presenting-gesture.jpg" alt="{{ t.featured.fhnw.altPresenting }}" class="fhnw-slide" loading="lazy">
          <img src="/assets/img/fhnw-talk-junior-dev-slide.jpg" alt="{{ t.featured.fhnw.altJuniorDevSlide }}" class="fhnw-slide" loading="lazy">
          <img src="/assets/img/fhnw-talk-hands-engaged.jpg" alt="{{ t.featured.fhnw.altEngagedAudience }}" class="fhnw-slide" loading="lazy">
        </div>
        <button class="fhnw-arrow fhnw-arrow--prev" aria-label="{{ t.featured.fhnw.prevSlide }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button class="fhnw-arrow fhnw-arrow--next" aria-label="{{ t.featured.fhnw.nextSlide }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
        </button>
        <div class="fhnw-dots">
          <button class="fhnw-dot active" aria-label="{{ t.featured.fhnw.slide }} 1"></button>
          <button class="fhnw-dot" aria-label="{{ t.featured.fhnw.slide }} 2"></button>
          <button class="fhnw-dot" aria-label="{{ t.featured.fhnw.slide }} 3"></button>
          <button class="fhnw-dot" aria-label="{{ t.featured.fhnw.slide }} 4"></button>
          <button class="fhnw-dot" aria-label="{{ t.featured.fhnw.slide }} 5"></button>
        </div>
      </div>
      <div class="featured-text reveal">
        <h3>{{ t.featured.fhnw.title | safe }}</h3>
        <p>{{ t.featured.fhnw.desc | safe }}</p>
        <div class="featured-badges">
          <a href="https://www.linkedin.com/posts/bbv-software-services_ki-softwareengineering-activity-7341725714343227392-xVB4" target="_blank" rel="noopener" class="badge">
            <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            {{ t.featured.fhnw.bbvPost }}
          </a>
          <a href="https://de.linkedin.com/posts/hochschule-f%C3%BCr-informatik-fhnw_fhnw-informatik-hsi-activity-7341831303979270144--ISp" target="_blank" rel="noopener" class="badge">
            <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            {{ t.featured.fhnw.fhnwPost }}
          </a>
          <a href="/assets/pdf/AI_Augmented_Software_Engineering_FHNW.pdf" target="_blank" rel="noopener" class="badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><polyline points="9 15 12 18 15 15"/></svg>
            {{ t.featured.fhnw.slides }}
          </a>
        </div>
      </div>
    </div>

    <div class="featured-text reveal">
      <h3>{{ t.featured.aiHub.title }}</h3>
      <p>{{ t.featured.aiHub.desc }}</p>
      <div class="featured-badges">
        <a href="https://bbvch-ai.github.io/aihub-core/{% if locale == 'de' %}de/{% endif %}" target="_blank" rel="noopener" class="badge">
          <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          {{ t.featured.aiHub.aiHubCoreDocs }}
        </a>
        <a href="https://bbvch-ai.github.io/swiss-ai-hub.ch/" target="_blank" rel="noopener" class="badge">
          <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          {{ t.featured.aiHub.swissAiHubDemo }}
        </a>
        <a href="https://ai-hub.bbv.ch/" target="_blank" rel="noopener" class="badge">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
          {{ t.featured.aiHub.bbvAiHub }}
        </a>
        <a href="https://www.swissmadesoftware.org/en/companies/bbv-software-services-ag/home.html" target="_blank" rel="noopener" class="badge">
          <svg viewBox="0 0 24 24"><path d="M3 3h18v18H3z"/><path d="M12 8v8M8 12h8"/></svg>
          {{ t.featured.aiHub.swissMadeSoftware }}
        </a>
        <a href="https://www.siemens.com/en-us/products/bbv-software-services-bbv-ai-hub-agentic-ai-platform/" target="_blank" rel="noopener" class="badge">
          <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          {{ t.featured.aiHub.siemensXcelerator }}
        </a>
        <a href="https://en.bbv.ch/" target="_blank" rel="noopener" class="badge">
          <svg viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 00-2 2v6a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg>
          {{ t.featured.aiHub.bbvSoftwareServices }}
        </a>
      </div>
    </div>

    <div class="featured-projects reveal">
      <div class="featured-project">
        <h3>{{ t.featured.mannhart.title }}</h3>
        <p>{{ t.featured.mannhart.desc }}</p>
        <div class="featured-badges">
          <a href="https://github.com/thommann/mannhart.ai" target="_blank" rel="noopener" class="badge">
            <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            {{ t.featured.mannhart.source }}
          </a>
        </div>
        <div class="timeline-tech">
          {% for tag in t.featured.mannhart.tech %}
          <span class="tech-tag">{{ tag }}</span>
          {% endfor %}
        </div>
      </div>
      <div class="featured-project">
        <h3>{{ t.featured.airspace.title }}</h3>
        <p>{{ t.featured.airspace.desc }}</p>
        <div class="featured-badges">
          <a href="https://github.com/johannschwabe/AirspaceAuctionSimulator" target="_blank" rel="noopener" class="badge">
            <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            {{ t.featured.airspace.source }}
          </a>
        </div>
        <div class="timeline-tech">
          {% for tag in t.featured.airspace.tech %}
          <span class="tech-tag">{{ tag }}</span>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
</div>
