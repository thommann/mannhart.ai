<div class="section-wrap section-wrap--alt angle-reverse">
  <section id="education">
    <a href="#education" class="section-header reveal">
      <span class="section-number">{{ t.education.number }}</span>
      <h2 class="section-title">{{ t.education.title }}</h2>
      <div class="section-line"></div>
    </a>
    <div class="edu-grid">
      {% for item in t.education.items %}
      <div class="edu-card reveal">
        <div class="edu-degree">{{ item.degree }}</div>
        <div class="edu-school">{{ item.school }}</div>
        <div class="edu-year">{{ item.year }}</div>
        <div class="edu-detail">
          {{ item.detail | safe }}
          {% if item.award %}
          <div class="award-badge">
            <a href="{{ item.award.href }}" target="_blank" rel="noopener" style="color:inherit;text-decoration:none;display:flex;align-items:center;gap:.5rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {{ item.award.label }}
            </a>
          </div>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
</div>
