<div id="chatbot">
  <button id="chatbot-toggle" aria-label="{{ t.chatbot.toggleAriaLabel }}">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
  </button>

  <div id="chatbot-panel" role="dialog" aria-labelledby="chatbot-header-title">
    <div id="chatbot-header">
      <span id="chatbot-header-title">{{ t.chatbot.title }}</span>
      <span id="chatbot-header-dot"></span>
      <button id="chatbot-close" type="button" aria-label="{{ t.chatbot.closeAriaLabel }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <div id="chatbot-messages" aria-live="polite">
      <div class="chatbot-msg chatbot-msg-bot">
        <div>{{ t.chatbot.greeting }}
          <ul class="chatbot-greeting-list">
            {% for feature in t.chatbot.greetingFeatures %}
            <li>{{ feature }}</li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
    <form id="chatbot-form">
      <input
        id="chatbot-input"
        type="text"
        placeholder="{{ t.chatbot.placeholder }}"
        aria-label="{{ t.chatbot.placeholder }}"
        autocomplete="off"
      />
      <button type="submit" id="chatbot-send" aria-label="{{ t.chatbot.sendAriaLabel }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"/>
          <polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </button>
    </form>
  </div>
</div>
<script>
window.__chatbotLocale = "{{ locale }}";
window.__chatbotStrings = {{ t.chatbot.errors | dump | safe }};
Object.assign(window.__chatbotStrings, {{ { confirmLangSwitchNote: t.chatbot.confirmLangSwitchNote, confirmLangSwitchLink: t.chatbot.confirmLangSwitchLink, alreadyOnLanguage: t.chatbot.alreadyOnLanguage, alreadyOnTheme: t.chatbot.alreadyOnTheme } | dump | safe }});
</script>
<script src="/assets/js/chatbot.js"></script>
