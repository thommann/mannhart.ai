<div id="chatbot">
  <button id="chatbot-toggle" aria-label="Chat">
    <svg id="chatbot-icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
    <svg id="chatbot-icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:none">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>

  <div id="chatbot-panel">
    <div id="chatbot-header">
      <span id="chatbot-header-title">{{ t.chatbot.title }}</span>
      <span id="chatbot-header-dot"></span>
    </div>
    <div id="chatbot-messages">
      <div class="chatbot-msg chatbot-msg-bot">
        <span>{{ t.chatbot.greeting }}</span>
      </div>
    </div>
    <form id="chatbot-form">
      <input
        id="chatbot-input"
        type="text"
        placeholder="{{ t.chatbot.placeholder }}"
        autocomplete="off"
      />
      <button type="submit" id="chatbot-send" aria-label="Send">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"/>
          <polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </button>
    </form>
  </div>
</div>
<script>window.__chatbotLocale = "{{ locale }}";</script>
<script src="/assets/js/chatbot.js"></script>
