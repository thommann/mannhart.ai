<section id="experience">
  <a href="#experience" class="section-header reveal">
    <span class="section-number">{{ t.experience.number }}</span>
    <h2 class="section-title">{{ t.experience.title }}</h2>
    <div class="section-line"></div>
  </a>
  <div class="timeline">
    {% for job in t.experience.jobs %}
    <div class="timeline-item reveal">
      <div class="timeline-date">{{ job.date }}</div>
      <div class="timeline-content">
        <h3 class="timeline-role">{{ job.role }}</h3>
        <div class="timeline-company">{{ job.company }}</div>
        <div class="timeline-location">{{ job.location }}</div>
        <ul class="timeline-desc">
          {% for item in job.desc %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>
        {% if job.assessment %}
        <a href="{{ job.assessment.href }}" target="_blank" rel="noopener" class="timeline-assessment">{{ job.assessment.label }}</a>
        {% endif %}
        {% if job.slides %}
        <a href="{{ job.slides.href }}" target="_blank" rel="noopener" class="timeline-slides">{{ job.slides.label }}</a>
        {% endif %}
        <div class="timeline-tech">
          {% for tag in job.tech %}
          <span class="tech-tag">{{ tag }}</span>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</section>
