{% set t = translations[locale] %}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Thomas Mannhart — {{ t.hero.label }}</title>
<meta name="description" content="{{ t.meta.description }}">
<meta name="theme-color" content="#0c0b0f">
<meta property="og:title" content="Thomas Mannhart — {{ t.hero.label }}">
<meta property="og:description" content="{{ t.meta.description }}">
<meta property="og:image" content="https://t.mannhart.ai/assets/img/photo-original.jpg">
<meta property="og:url" content="https://t.mannhart.ai/{{ locale }}/">
<meta property="og:type" content="website">
<link rel="alternate" hreflang="de" href="/de/">
<link rel="alternate" hreflang="en" href="/en/">
<link rel="alternate" hreflang="x-default" href="/de/">
<link rel="stylesheet" href="/assets/css/style.css">
<script>
(function(){
  var t = localStorage.getItem('theme');
  if (!t) t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
  if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
})();
</script>
</head>
<body>

{{ content | safe }}

<script src="/assets/js/main.js"></script>
</body>
</html>
