# LLM provider configuration
# The openai npm package works with any OpenAI-compatible API.
# Just change LLM_BASE_URL and LLM_MODEL to switch providers.

LLM_API_KEY=sk-...

# OpenAI (default)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Groq (very cheap & fast)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Together AI
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Google Gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# Mistral
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-small-latest

# Comma-separated fallback models tried when primary hits quota limits
# LLM_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.1-flash-lite-preview

ALLOWED_ORIGIN=https://t.mannhart.ai
PORT=3001
